# Copy to .env.production and fill in before: npm run build
# Footer legal links + back-to-login target https://vantagedating.com in src/App.jsx.

# Google Analytics 4 (gtag loads from src/analytics.js — do not duplicate script in index.html)
VITE_GA_MEASUREMENT_ID=G-NHY9GW6GKG

# Public URL of this landing site (no trailing slash) — canonical, Open Graph, JSON-LD
# VITE_SITE_URL=https://www.yourdomain.com

# Optional: full URL for social share image (or add public/og-image.png and set VITE_SITE_URL)
# VITE_OG_IMAGE_URL=https://www.yourdomain.com/og-image.png
